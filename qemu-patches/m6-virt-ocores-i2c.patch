+
+#define OCORES_I2C_BASE  0x103000
+#define OCORES_I2C_IRQ   13
+#define OCORES_I2C_SIZE  0x14
+
+static void create_fdt_ocores_i2c(RISCVVirtState *s, uint32_t irq_mmio_phandle)
+{
+    g_autofree char *name = NULL;
+    g_autofree char *tmp = NULL;
+    MachineState *ms = MACHINE(s);
+
+    name = g_strdup_printf("/soc/i2c@%" PRIx64, (uint64_t)OCORES_I2C_BASE);
+    qemu_fdt_add_subnode(ms->fdt, name);
+    qemu_fdt_setprop_string(ms->fdt, name, "compatible",
+                            "opencores,i2c-ocores");
+    qemu_fdt_setprop_sized_cells(ms->fdt, name, "reg",
+                                 2, OCORES_I2C_BASE, 2, OCORES_I2C_SIZE);
+    qemu_fdt_setprop_cell(ms->fdt, name, "interrupt-parent", irq_mmio_phandle);
+    if (s->aia_type == VIRT_AIA_TYPE_NONE) {
+        qemu_fdt_setprop_cell(ms->fdt, name, "interrupts", OCORES_I2C_IRQ);
+    } else {
+        qemu_fdt_setprop_cells(ms->fdt, name, "interrupts", OCORES_I2C_IRQ, 0x4);
+    }
+    qemu_fdt_setprop_cell(ms->fdt, name, "reg-shift", 2);
+    qemu_fdt_setprop_cell(ms->fdt, name, "reg-io-width", 4);
+    qemu_fdt_setprop_cell(ms->fdt, name, "opencores,ip-clock-frequency",
+                          20000000);
+    qemu_fdt_setprop_cell(ms->fdt, name, "clock-frequency", 100000);
+    qemu_fdt_setprop_cell(ms->fdt, name, "#address-cells", 1);
+    qemu_fdt_setprop_cell(ms->fdt, name, "#size-cells", 0);
+
+    tmp = g_strdup_printf("%s/tmp105@48", name);
+    qemu_fdt_add_subnode(ms->fdt, tmp);
+    qemu_fdt_setprop_string(ms->fdt, tmp, "compatible", "ti,tmp105");
+    qemu_fdt_setprop_cells(ms->fdt, tmp, "reg", 0x48);
+}
+
